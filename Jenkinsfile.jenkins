pipeline {
    agent any
    
    options {
        timeout(time: 1, unit: 'HOURS')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        PYTHON_VERSION = '3.9'
        BROWSER = 'Chrome'
        TEST_ENVIRONMENT = 'QA'
        ALLURE_HOME = "${WORKSPACE}/allure-cli/allure-2.39.0"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '========== Checking out code from repository =========='
                checkout scm
                echo '========== Checkout completed =========='
            }
        }
        
        stage('Setup Environment') {
            steps {
                echo '========== Setting up Python Environment =========='
                script {
                    bat '''
                        @echo off
                        echo Creating virtual environment...
                        python -m venv .venv
                        echo Activating virtual environment...
                        call .venv\\Scripts\\activate.bat
                        echo Installing dependencies...
                        pip install --upgrade pip
                        pip install -r requirements.txt
                        echo Environment setup completed
                    '''
                }
            }
        }
        
        stage('Lint & Validate') {
            steps {
                echo '========== Running Code Quality Checks =========='
                script {
                    bat '''
                        @echo off
                        call .venv\\Scripts\\activate.bat
                        echo Running pylint...
                        pylint SWAGLABSTEST --disable=all --enable=E,F || true
                        echo Code quality checks completed
                    '''
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                echo '========== Running Automated Tests =========='
                script {
                    bat '''
                        @echo off
                        call .venv\\Scripts\\activate.bat
                        echo Running pytest with Allure reporting...
                        pytest SWAGLABSTEST --alluredir=allure-results -v --tb=short
                        if %ERRORLEVEL% neq 0 (
                            echo Some tests failed, but continuing to generate report
                        )
                    '''
                }
            }
        }
        
        stage('Generate Allure Report') {
            steps {
                echo '========== Generating Allure Test Report =========='
                script {
                    bat '''
                        @echo off
                        echo Generating Allure report...
                        %ALLURE_HOME%\\bin\\allure generate allure-results --clean -o allure-report
                        echo Allure report generated successfully
                    '''
                }
            }
        }
        
        stage('Publish Results') {
            steps {
                echo '========== Publishing Test Results =========='
                script {
                    // Publish JUnit results if available
                    junit testResults: '**/test-results/*.xml', allowEmptyResults: true
                    
                    // Archive allure results
                    archiveArtifacts artifacts: 'allure-report/**', fingerprint: true
                    
                    echo 'Test results published'
                }
            }
        }
        
        stage('Cleanup') {
            steps {
                echo '========== Cleaning up workspace =========='
                script {
                    bat '''
                        @echo off
                        echo Cleaning up temporary files...
                        if exist "allure-results" (
                            echo Keeping allure-results for next run
                        )
                        echo Cleanup completed
                    '''
                }
            }
        }
    }
    
    post {
        failure {
            echo '========== Build Failed =========='
            echo "Check logs: ${env.BUILD_URL}console"
            echo "Allure Report: ${env.BUILD_URL}artifact/allure-report/index.html"
        }

        success {
            echo '========== All Tests Passed Successfully =========='
            echo "Build URL: ${env.BUILD_URL}artifact/allure-report/index.html"
        }

        unstable {
            echo '========== Build is Unstable =========='
        }

        always {
            script {
                node {
                    echo '========== Cleaning up workspace =========='
                    cleanWs()
                }
            }
        }
    }
}
